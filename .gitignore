# ===================================
# Python & Environment
# ===================================
# Ignore the Python cache folder
__pycache__/

# Ignore the virtual environment folder
venv/
.venv/


# ===================================
# Sensitive Credentials
# ===================================
# Ignore the Streamlit secrets file to prevent committing credentials
.streamlit/secrets.toml
.env


# ===================================
# Generated Data & Models
# ===================================
# These folders are populated by the scripts and should not be version controlled.

# Ignore downloaded raw Excel files
data/raw/

# Ignore processed CSV files
data/processed/

# Ignore all trained machine learning models
models/


# ===================================
# Non-Code / Informational Files
# ===================================
# These files are for information only and not part of the core application code.
FOLDER_STRUCTURE.TXT
packages.txt